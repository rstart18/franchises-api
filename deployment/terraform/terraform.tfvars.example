project_name       = "franchises-api"
environment        = "dev"
aws_region         = "us-east-1"
db_username        = "franchises_admin"
db_name            = "franchises_db"
db_instance_class  = "db.t3.micro"
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

# Poner en true si usas una cuenta AWS Free Tier
# Deshabilita: backups automáticos, encryption en reposo, auto scaling de storage
free_tier = false

# Never commit db_password — set it via TF_VAR_db_password environment variable:
# export TF_VAR_db_password="your-secure-password"
